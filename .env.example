# GitHub API Token (required for comment submission feature)
# Create a token at: https://github.com/settings/tokens
# Requires: public_repo scope (to create issues in the public repo)
# Only needed if running the server locally with comment submission enabled
GITHUB_TOKEN=github_pat_your_token_here

# Port (optional, defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# --- HTI-5 OIRA review alerts ---

# Resend API key. Must be a FULL-ACCESS key: a sending-only key returns 401
# restricted_api_key on the contacts and broadcasts endpoints.
RESEND_API_KEY=re_your_key_here

# Verified Resend sending domain. hti5.org is not verified; salundo.com is.
ALERT_FROM=HTI-5 Alerts <alerts@salundo.com>

# Resend segment that confirmed subscribers are added to.
ALERT_SEGMENT_ID=seg_your_segment_id

# HMAC key for double opt-in confirmation links. Generate with:
#   openssl rand -base64 32
CONFIRM_SECRET=replace_me

# Physical mailing address shown in email footers (CAN-SPAM requirement for
# list email). Omitted from footers if unset.
ALERT_POSTAL_ADDRESS=

# Public origin used to build confirmation links.
SITE_URL=https://hti5.org

# Shared secret for the cron endpoint. Vercel sends this as a Bearer token
# automatically when set as a project environment variable.
CRON_SECRET=replace_me

# Vercel Edge Config, used to persist watcher state.
# EDGE_CONFIG is the read connection string; the other two authorize writes.
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx
EDGE_CONFIG_ID=ecfg_xxx
VERCEL_API_TOKEN=your_vercel_token
VERCEL_TEAM_ID=team_VQpNZDgcr3AMHl5U6P8KSIaj

# RIN to watch. Override only for testing against a rule already in the feed.
WATCH_RIN=0955-AA09
